@startuml Package Dependencies
!theme plain
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor white
skinparam package {
    BackgroundColor #F8F8F8
    BorderColor #333333
}
skinparam component {
    BackgroundColor #E8E8E8
    BorderColor #555555
}

title Package Dependencies

package "App Targets" as apps {
    [iOS App\n(thin shell)] as ios
    [watchOS App\n(thin shell)] as watch
    [visionOS App\n(thin shell)] as vision
}

package "Shared UI" as shared_ui {
    [NarbisUI] as nui
}

package "App Logic" as app_logic {
    [NarbisKit] as nk
    [NarbisWatchKit] as nwk
}

package "Core Library" as core {
    [BioFeedbackKit\nSignal / Algorithm / Feedback\nDevices / Config] as bfk
}

package "Device Adapters" as adapters {
    [BFK-HealthKit\n(input+output\nApple Watch)] as hk
    [BFK-Polar\n(input)] as polar
    [BFK-EdgeBLE\n(output)] as edge
}

package "Hardware SDK" as sdk {
    [EdgeSDK-Swift\n(byte protocol)] as esdk
}

ios --> nui
watch --> nui
vision --> nui

ios --> nk
vision --> nk
watch --> nwk

nui --> nk
nui --> nwk
nk --> bfk
nwk --> bfk

bfk --> hk
bfk --> polar
bfk --> edge

edge --> esdk

note bottom of bfk
  Pure Swift — no platform dependencies.
  Cross-platform core powering all targets.
end note

@enduml

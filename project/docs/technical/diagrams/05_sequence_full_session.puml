@startuml Full Session Sequence
!theme plain
skinparam defaultFontSize 10
skinparam shadowing false
skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam maxMessageSize 200

title Full Session Sequence Diagram

actor User
participant "HomeView" as Home
participant "ConnectView" as Connect
participant "TrainingVM" as TVM
participant "Apple Watch" as Watch
participant "iOS WCBridge" as WCB
participant "CoherenceEngine" as Engine
participant "EdgeGlasses" as Edge

User -> Home : Start Training
Home -> Connect : show sheet

Connect -> Connect : startScan()\n(BLE scan)

User -> Connect : select devices
Connect -> TVM : connect()

TVM -> Edge : connect()\n[BLE connect]
activate Edge
TVM -> Watch : connect()
activate Watch
Watch -> WCB : startRelay\n(WCSession)

TVM -> Edge : configureSession()\n[0xA3 + 0xA4]

== SETTLING PHASE (30s) ==

Watch -> WCB : RR interval\n(WCSession)
WCB -> Engine : route →\nBioSample
Engine -> Engine : addSample()\n(warmup)

== TRAINING PHASE (15 min) ==

loop ~1 Hz for 15 minutes
    Watch -> WCB : RR interval\n(WCSession)
    WCB -> Engine : route →\nBioSample
    Engine -> Engine : addSample()\n→ coherence
    Engine -> TVM : CoherenceResult
    TVM -> Edge : FeedbackUpdate\n[0xA2 brightness]
    note right of Edge
        **[Cl. 6, 32]**
        Lens clarity varies
        as reward/penalty
    end note
end

User -> Home : Stop

TVM -> Edge : disconnect()\n[0x00 + 0xA7]
deactivate Edge
TVM -> Watch : stopRelay
deactivate Watch
Watch -> WCB : WCSession

TVM -> TVM : save(SessionSummary)
TVM -> Home : results
Home -> User : show results

@enduml
